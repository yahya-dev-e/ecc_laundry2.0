name: Audit fixes regression
on:
  push:
    branches: ['codex/**']
  workflow_dispatch:
permissions:
  contents: read
jobs:
  node18-build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '18.8.0'
          cache: npm
      - run: npm ci --engine-strict
      - run: npm run build
  regression:
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest, macos-latest]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4
      - uses: shivammathur/setup-php@v2
        with:
          php-version: '8.3'
          extensions: pdo_sqlite, mbstring, intl, zip
          coverage: none
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: npm
      - run: composer install --prefer-dist --no-interaction
      - run: composer audit --locked
      - run: npm ci --ignore-scripts
      - run: npm audit --audit-level=moderate
      - run: npm run build
      - run: php vendor/phpunit/phpunit/phpunit --fail-on-warning
      - run: php tests/integration/upgrade.php
      - run: php tests/integration/concurrency.php
      - run: php tests/integration/cycle-outage.php
      - run: node tests/integration/smtp.mjs
      - run: npm ci --prefix tests/browser
      - run: npm exec --prefix tests/browser -- playwright install --with-deps chromium firefox webkit
      - run: node tests/browser/run.mjs
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: browser-results-${{ matrix.os }}
          path: tests/browser/evidence/
  mysql:
    runs-on: ubuntu-latest
    services:
      mysql:
        image: mysql:8.4
        env:
          MYSQL_DATABASE: laundry_test
          MYSQL_ROOT_PASSWORD: ci-only-password
        ports: ['3306:3306']
        options: >-
          --health-cmd="mysqladmin ping -h localhost -pci-only-password"
          --health-interval=5s --health-timeout=5s --health-retries=20
    env:
      APP_ENV: testing
      APP_KEY: base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
      DB_CONNECTION: mysql
      DB_HOST: 127.0.0.1
      DB_PORT: 3306
      DB_DATABASE: laundry_test
      DB_USERNAME: root
      DB_PASSWORD: ci-only-password
      LAUNDRY_TEST_DB: mysql
    steps:
      - uses: actions/checkout@v4
      - uses: shivammathur/setup-php@v2
        with:
          php-version: '8.3'
          extensions: pdo_mysql, pdo_sqlite, mbstring, intl
          coverage: none
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - run: composer install --prefer-dist --no-interaction
      - run: npm ci --ignore-scripts
      - run: npm run build
      - run: php vendor/phpunit/phpunit/phpunit --fail-on-warning
      - run: php tests/integration/concurrency.php
  container:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: docker build -f .docker/8.3/Dockerfile -t ecc-laundry:test .
