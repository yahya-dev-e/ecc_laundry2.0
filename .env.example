APP_NAME="ECC Laundry"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Casablanca
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
DB_CONNECTION=sqlite
# Omit DB_DATABASE for the default absolute database/database.sqlite path.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
# Set true with production HTTPS. Production defaults to secure cookies.
# SESSION_SECURE_COOKIE=true
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME="${APP_NAME}"
LAUNDRY_WEEKLY_HOURS_LIMIT=8
LAUNDRY_ADMIN_WEEKLY_HOURS_LIMIT=100
LAUNDRY_RESTRICT_CURRENT_WEEK=true
# Demo accounts are off by default and forbidden outside local/testing:
DEMO_SEED_ENABLED=false
DEMO_PASSWORD=

# Isolated private test deployment only. Empty emails deny every account.
PRIVATE_TEST_ENABLED=false
PRIVATE_TEST_EMAILS=
PRIVATE_TEST_NETWORKS=127.0.0.1/32,::1/128
